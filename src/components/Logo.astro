---
interface Props { href: string; label: string }
const { href, label } = Astro.props;
---
<a class="logo" href={href} aria-label={label}>
  <svg viewBox="0 0 512 512" width="28" height="28" aria-hidden="true">
    <path fill="currentColor" fill-rule="evenodd" d="M152 64H360C409 64 448 103 448 152V296C448 345 409 384 360 384H192L88 448V362C73 346 64 322 64 296V152C64 103 103 64 152 64ZM278 144L182 304H234L330 144Z" />
  </svg>
  <span class="word">discordtools<span class="tld">.de</span></span>
</a>
<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    text-decoration: none;
    font-weight: 750;
    letter-spacing: -0.03em;
    font-size: 1.1rem;
  }
  .logo svg { color: var(--accent); flex: none; }
  .tld { color: var(--faint); font-weight: 600; }
  .logo:hover { color: var(--text); }
  .logo:hover svg { transform: rotate(-6deg); }
  .logo svg { transition: transform 0.25s var(--ease); }
</style>
